{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:3200",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@cc/web",
        "--",
        "--port",
        "5373",
        "--strictPort"
      ],
      "port": 5373
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3200",
        "FRONTEND_URL=http://localhost:5373",
        "API_PUBLIC_URL=http://localhost:3200",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@cc/api"
      ],
      "port": 3200
    }
  ]
}
