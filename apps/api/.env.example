PORT=3000
# Where the web app runs, for CORS. Several addresses may be listed, comma-separated.
FRONTEND_URL=http://localhost:5173
# The shared dev database on Railway (DEVELOPMENT.md), with row-level security on (docs/tenant-isolation.md):
#   DATABASE_URL         the restricted role cc_app, the API's own connection: apps/api/scripts/dev-db-url.sh --app
#   SCHEMA_DATABASE_URL  the owner, for migrations, the seed and scripts:     apps/api/scripts/dev-db-url.sh
# It is shared, so never run prisma migrate dev or migrate reset against it, and the seed asks for --confirm-host.
DATABASE_URL=
SCHEMA_DATABASE_URL=
REQUIRE_TENANT_RLS=on
# Trip photos go to the dev R2 bucket, the one api-dev uses (copy the values from Railway's dev variables).
# Unset, photo uploads answer that they are not set up.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PHOTOS_BUCKET=
# Where contact form messages go.
SUPPORT_EMAIL=support@travel-hq.app
# Resend's API key. Leave it empty on a laptop: email is then logged, not sent.
RESEND_API_KEY=
# The sender, on a domain verified in that Resend account (dev and production use separate accounts).
EMAIL_FROM=
# The Resend webhook's signing secret (whsec_…), for bounce and spam-complaint notices. Unset, the webhook refuses them.
RESEND_WEBHOOK_SECRET=
# Dev only: send every email to this address instead, marked as a test that names who it was for. Empty: send normally.
DEV_EMAIL_TO=
# Forwarded receipts: the subdomain Resend receives on (e.g. receipts.dev.travel-hq.app) and a Full access Resend key
# to read each email. Leave both empty on a laptop: receiving is then off.
RECEIPTS_DOMAIN=
RESEND_RECEIVING_API_KEY=
# Clerk secret key (organizer sign-in). Never commit it; get it from the Clerk dashboard.
CLERK_SECRET_KEY=
