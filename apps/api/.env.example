PORT=3000
# Where the web app runs, for CORS.
FRONTEND_URL=http://localhost:5173
# Local Postgres (docker compose). To work against the shared dev database instead, use its DATABASE_PUBLIC_URL
# (DEVELOPMENT.md); then never run db:migrate or db:reset, and the seed asks for --confirm-host.
DATABASE_URL=postgresql://cc_user:cc_password@localhost:5432/crewcontrol
# The address photo URLs are built from (no trailing slash).
API_PUBLIC_URL=http://localhost:3000
# Where uploaded photos are written. On Railway, point this at a mounted volume.
UPLOAD_DIR=./storage/uploads
