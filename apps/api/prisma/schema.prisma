generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The API's connection: the restricted role that row-level security binds (docs/tenant-isolation.md).
  url       = env("DATABASE_URL")
  // The database owner, for Prisma's CLI (migrations): the restricted role can't change the schema.
  directUrl = env("SCHEMA_DATABASE_URL")
}

// One group trip. The organizer edits it; guests see the published version at /t/<slug>.
// Photos, highlights and key dates are ordered lists the organizer replaces whole on save,
// so they live as JSON on the trip rather than as tables of their own.
model Trip {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  destination         String
  startDate           String // 'YYYY-MM-DD', a calendar date with no time zone
  endDate             String
  organizerName       String
  description         String
  costPerPersonCents  Int
  installmentCount    Int                  @default(1)
  // When each installment is due ('YYYY-MM-DD'[], one per installment) or [] when not set, and how many days before
  // each one guests who owe are reminded (null: no payment reminders). Migration 20261029060000_reminders.
  paymentDueDates     Json                 @default("[]")
  paymentReminderDays Int?
  // The first payment, which holds the spot, when the organizer sets one; null splits the price evenly.
  firstPaymentCents   Int?
  galleryTitle        String               @default("Photos")
  showGuestNames      Boolean              @default(false)
  // Shown only to signed-in guests who joined the trip (their join page). Never on the public page.
  // How guests can pay the organizer (PaymentMethod[]: a fixed kind with its handle, or a free-form one), and a note
  // for anything else. A guest picks one of the methods when they report a payment.
  paymentMethods      Json                 @default("[]")
  paymentInstructions String               @default("")
  published           Boolean              @default(false)
  // A demo trip from the seed. The homepage shows only these, and their pages carry a "Sample Trip" badge.
  isSample            Boolean              @default(false)
  // The most guests the trip takes. Null means no limit.
  maxGuests           Int?
  // How guests who signed get in: 'accept_first' (the organizer accepts each one, then they pay), 'pay_first' (they
  // pay, then the organizer accepts each one whose payment arrived) or 'first_come' (they pay, and confirming a
  // payment accepts them while spots are left).
  joinMode            String               @default("accept_first")
  // How refunds work when a guest drops out (RefundPolicy): 'spot_filled' or 'first_payment_kept'. Presets only, and
  // fixed once a guest has signed (migration 20261026040000_refund_policy).
  refundPolicy        String               @default("spot_filled")
  photos              Json                 @default("[]") // TripPhoto[]; the first is the cover
  highlights          Json                 @default("[]") // TripHighlight[]
  keyDates            Json                 @default("[]") // TripKeyDate[]
  // TripOptions: settings that only change what the pages show (room choice, the sign-up lines). A setting the
  // database must enforce gets its own column instead.
  options             Json                 @default("{}")
  // The part before the @ of the trip's own address for forwarded receipts (the domain is the environment's,
  // RECEIPTS_DOMAIN). Changed, never cleared; every address used is kept in ReceiptsAddress (migration
  // 20261029080000_receipt_forwarding).
  receiptsAddress     String?              @unique
  // Deleted by an owner: hidden from everyone but the admin, then erased for good 30 days later (TripDeletionService,
  // migration 20261030020000_trip_deletion). A deleted trip is never published.
  deletedAt           DateTime?
  deletedByUserId     String?
  // Save the date (issue #47, migration 20261031080000_trip_interest): the page takes "I'm interested" instead of
  // sign-ups, and nobody can sign. Turning it off opens sign-ups.
  saveTheDate         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  guests              Guest[]
  members             TripMember[]
  invites             TripInvite[]
  rooms               Room[]
  log                 TripLog[]
  agreements          AgreementSignature[]
  payments            Payment[]
  expenses            Expense[]
  reminderSends       ReminderSend[]
  adjustments         BalanceAdjustment[]
  forwardedReceipts   ForwardedReceipt[]
  payerAddresses      PayerAddress[]
  announcements       Announcement[]
  questions           TripQuestion[]
  emailSends          EmailSend[]
  actionAlerts        ActionAlert[]
  interest            TripInterest[]

  @@index([deletedAt])
}

// Who works on a trip: an owner runs it and decides who else organizes it, an organizer works on it beside them.
// userId is the sign-in provider's user id. Row-level security draws the line between trips from these rows
// (migration 20261021050000_trip_rls).
model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String // 'owner' | 'organizer'
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

// Someone joining a trip. They sign in, sign the agreement and pay the organizer; then the organizer accepts them
// (or, on a first come, first served trip, confirming their payment does).
model Guest {
  id                    String                  @id @default(cuid())
  tripId                String
  // The signed-in person who joined (the sign-in provider's user id). Null for guests added before sign-in, and for a
  // traveler someone else signed up until that traveler signs in themselves (claim_managed_guest).
  userId                String?
  // Whose account signed this traveler up and looks after them (a parent, a friend paying for a roommate), when it
  // wasn't the traveler (migration 20261028050000_responsible_party). Organizers can change it.
  managedByUserId       String?
  // Emails to them bounced or they marked one as spam (Resend's webhook, migration 20261029040000_email_problems):
  // 'bounced' | 'complained', cleared when an organizer fixes the address or says they've seen it.
  emailProblem          String?
  emailProblemAt        DateTime?
  firstName             String
  lastName              String
  email                 String
  phone                 String
  status                String                  @default("interested") // 'interested' | 'approved' | 'declined'
  createdAt             DateTime                @default(now())
  // When the payments the organizer confirmed first added up to the first payment the guest's agreement asked for
  // (kept by the database from Payment, migration 20261025010000_payment_log). On a first come, first served trip
  // spots go in this order.
  spotPaidAt            DateTime?
  // When they joined onto the waitlist (the trip was full), and when an organizer offered them a spot that opened
  // (migration 20261026020000_waitlist). Waitlisted and not offered: no way to pay shown, and no payment taken.
  waitlistedAt          DateTime?
  offeredAt             DateTime?
  // When the organizer, turning a paid guest down, said the refund went out. Records it; moves no money.
  refundSentAt          DateTime?
  // The room the guest asked for (the organizer can change it), and who they'd like to share with.
  roomId                String?
  roomNote              String                  @default("")
  // When the guest pressed "Stop updates for this trip" in a reminder email (migration 20261029060000_reminders):
  // reminders skip them. Trip business emails (signing, being accepted) still go.
  updatesStoppedAt      DateTime?
  // The guest's own secret in that link; it names this guest row and nothing else.
  updatesToken          String                  @unique @default(dbgenerated("(gen_random_uuid())::text"))
  // The room price the difference from the signed price was last settled at, as a credit or charge or left alone
  // (migration 20261029070000_room_prices); null: never.
  roomPriceSettledCents Int?
  room                  Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  trip                  Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  agreement             AgreementSignature?
  events                GuestEvent[]
  payments              Payment[]
  adjustments           BalanceAdjustment[]
  payerAddresses        PayerAddress[]
  reminderSends         ReminderSend[]
  announcementsFor      AnnouncementRecipient[]
  announcementReplies   AnnouncementReply[]

  @@unique([tripId, userId])
  @@unique([id, tripId])
  @@index([tripId])
  @@index([userId])
  @@index([managedByUserId])
}

// The trip agreement a guest signed, never changed once written (migration 20261023020000_join_and_agreements): the
// text exactly as shown and its SHA-256, the terms it quoted (the guest's balance comes from these, not the trip's
// current settings), the name they typed, and when and from where they signed.
model AgreementSignature {
  id               String   @id @default(cuid())
  tripId           String
  guestId          String   @unique
  templateVersion  String
  text             String
  textHash         String
  priceCents       Int
  installmentCount Int
  startDate        String
  endDate          String
  refundTerms      String
  // The payment plan as signed (PlannedPayment[]: amount and due date per installment); [] on agreements from before
  // plans had dates (migration 20261029060000_reminders).
  schedule         Json     @default("[]")
  typedName        String
  // Whose account signed it on the traveler's behalf (issue #11); null when the traveler signed it themselves.
  signedByUserId   String?
  signedAt         DateTime @default(now())
  ipAddress        String
  userAgent        String
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest            Guest    @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([guestId, tripId])
  @@index([tripId])
}

// One line of a guest's history, written only by the database's triggers (migration 20261024010000_guest_history):
// what happened, when, and who did it. Members of the trip read it; nobody writes, changes or deletes a line.
model GuestEvent {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId       String
  guestId      String
  at           DateTime @default(now())
  // 'joined' | 'signed' | 'said_paid' | 'payment_confirmed' | 'payment_not_received' | 'payment_undone' |
  // 'accepted' | 'turned_down' | 'put_back' | 'refund_sent' | 'refund_undone' | 'room_changed' | 'contact_changed'
  kind         String
  actorUserId  String?
  actor        String // 'guest' | 'organizer' | 'system'
  fromRoomId   String?
  toRoomId     String?
  // For contact_changed: which details changed ('name', 'email', 'phone'), never their values.
  fields       String?
  // For the payment kinds: which payment, and its amount in whole cents (what the guest said they sent, or what the
  // organizer confirmed arrived).
  paymentId    String?
  amount       Int?
  // For the adjustment kinds: which adjustment (its reason is there).
  adjustmentId String?
  n            Int      @default(autoincrement())
  guest        Guest    @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([guestId, at, n])
  @@index([tripId])
}

// Money the organizer pays out for the trip, a vendor's bill (migration 20261028040000_expenses). Recorded only, never
// moved. Paid once paidOn is set; until then still owed, by dueOn when there is one. Its trip's members only.
model Expense {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId          String
  payee           String
  description     String   @default("")
  amountCents     Int
  paidOn          String? // 'YYYY-MM-DD'
  dueOn           String? // 'YYYY-MM-DD'
  createdAt       DateTime @default(now())
  createdByUserId String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// A credit or charge the organizer puts on a guest's balance by hand, with a reason (migration
// 20261029010000_balance_adjustments). Not a payment: recorded only. Never edited; removing it keeps it, marked removed.
model BalanceAdjustment {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId          String
  guestId         String
  kind            String // 'credit' | 'charge'
  amountCents     Int
  reason          String
  createdAt       DateTime  @default(now())
  createdByUserId String
  removedAt       DateTime?
  removedByUserId String?
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest           Guest     @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([tripId])
  @@index([guestId])
}

// One reminder email to one guest (migration 20261029060000_reminders): a key date's reminder goes to each guest once,
// and this row is written before it's sent, so two runs never send it twice. `key` names the installment or key date
// it's about. Written by trusted work only; the trip's members read them.
model ReminderSend {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId     String
  guestId    String
  key        String
  date       String // 'YYYY-MM-DD'
  label      String
  paymentDue Boolean  @default(false)
  sentAt     DateTime @default(now())
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest      Guest    @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([guestId, key])
  @@index([tripId])
}

// An organizer's post to the guests who joined, and the replies under it (migration 20261029090000_announcements).
model Announcement {
  id           String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId       String
  authorUserId String
  authorName   String
  body         String
  audience     String // AnnouncementAudience
  pinned       Boolean                 @default(false)
  emailed      Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  trip         Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  recipients   AnnouncementRecipient[]
  replies      AnnouncementReply[]

  @@unique([id, tripId])
  @@index([tripId])
}

model AnnouncementRecipient {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  announcementId String
  tripId         String
  guestId        String
  emailedAt      DateTime?
  announcement   Announcement @relation(fields: [announcementId, tripId], references: [id, tripId], onDelete: Cascade)
  guest          Guest        @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([announcementId, guestId])
  @@index([tripId])
  @@index([guestId])
}

model AnnouncementReply {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  announcementId String
  tripId         String
  guestId        String?
  authorUserId   String
  authorName     String
  body           String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId, tripId], references: [id, tripId], onDelete: Cascade)
  guest          Guest?       @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([announcementId])
  @@index([tripId])
}

// One payment a guest sent the organizer, for any installment (migration 20261025010000_payment_log). The guest
// reports it (or the organizer logs one handed over in person); the organizer confirms it arrived or says it didn't.
// Amounts are whole cents. The guest's amount is never changed, so their word stays on record beside what arrived.
model Payment {
  id                    String    @id @default(cuid())
  tripId                String
  guestId               String
  // What the guest says they sent.
  guestPaymentAmount    Int
  // What the organizer says arrived, set when they confirm it (filled in with the guest's amount unless changed).
  receivedPaymentAmount Int?
  // How it was paid, as the guest picked it from the trip's methods ("Zelle · (555) 010-0199"), and its kind.
  method                String
  methodKind            String // PaymentMethodKind
  sentOn                String // 'YYYY-MM-DD', the day the guest says they sent it
  // Why, when it is less than what was due. Required then.
  note                  String    @default("")
  status                String    @default("reported") // 'reported' | 'confirmed' | 'not_received'
  loggedBy              String    @default("guest") // 'guest' | 'organizer' | 'email' (a forwarded receipt)
  // Who sent it, by name, when someone paid for this traveler ('' when the traveler reported it themselves).
  paidByName            String    @default("")
  // One transfer for several travelers: the rows it pays share this, and are confirmed together. Null for one person.
  transferId            String?
  reportedAt            DateTime  @default(now())
  decidedAt             DateTime?
  decidedByUserId       String?
  // With 'refunded': the refund it went back with (the guest's refundSentAt then), so undoing that refund counts
  // only these payments again.
  refundedAt            DateTime?
  trip                  Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest                 Guest     @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([tripId])
  @@index([guestId, reportedAt])
  @@index([tripId, transferId])
}

// A room or sleeping space on a trip, in the organizer's order. Edited in place so guests' room choices stick.
model Room {
  id         String   @id @default(cuid())
  tripId     String
  position   Int
  name       String
  beds       String   @default("")
  capacity   Int
  weight     Float    @default(1)
  // The beds in it, in order (BED_TYPES), for the room pictures guests choose from.
  bedTypes   String[] @default([])
  // The fewest people the room is priced for. Fewer than this and they pay for the empty places too.
  minPeople  Int      @default(1)
  // What a guest in this room pays, per person; null: the trip's price (migration 20261029070000_room_prices).
  priceCents Int?
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  guests Guest[]

  @@index([tripId])
}

// Every change the platform admin makes to a trip's people (seating itself, handing a trip to an owner), written by
// the TripMember_9_admin_logged trigger, never by the API (migration 20261021070000_rooms_owners_access_log).
// What the trip's organizers should know beyond a guest's own history (migration 20261024020000_trip_log): for now,
// joins refused because the email is already on the trip, with what was typed and from where. Written only by
// log_refused_email; members read it.
model TripLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId      String
  at          DateTime @default(now())
  kind        String // 'email_refused'
  actorUserId String?
  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  blocked     Boolean  @default(false)
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
}

/// Someone invited to run a trip before they signed in; turned into a TripMember when they do (migration 20261028030000).
model TripInvite {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId    String
  email     String // lowercased
  role      String // 'owner' | 'organizer'
  invitedBy String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
  @@index([email])
}

model AccessLog {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId        String
  actorUserId   String
  action        String
  subjectUserId String
  role          String?
  oldRole       String?
  at            DateTime @default(now())
  byAdmin       Boolean  @default(true)

  @@index([tripId])
}

/// One person accepting one version of one of Travel HQ's own documents (src/terms/terms-text.ts): 'use', the Terms of
/// Use, or 'organizer', the Organizer Terms. Only ever added. No relation to a trip: acceptance is the person's.
model TermsAcceptance {
  id          String   @id @default(cuid())
  userId      String
  kind        String // 'use' | 'organizer'
  fingerprint String
  acceptedAt  DateTime @default(now())
  ipAddress   String
  userAgent   String

  @@unique([userId, kind, fingerprint])
}

// app-wide values the platform admin sets in the Admin toolbox ("System Settings"), one row (id 1). Everyone
// reads them; only the admin changes them (migration 20261026030000_system_settings).
model SystemSettings {
  id                    Int      @id @default(1)
  // On the pay-first trips, joining goes to the waitlist once those who can pay fill the spots left plus this percent.
  waitlistBufferPercent Int      @default(10)
  // The limited preview (issue #39): on, only admins and approved early access start trips; off, anyone signed in.
  limitedPreview        Boolean  @default(true)
  // After an organizer alert, how long before the next one to the same person (migration 20261031070000).
  alertWindowHours      Int      @default(4)
  updatedAt             DateTime @default(now())
  updatedByUserId       String?
}

// What organizers ask Travel HQ for that it doesn't do yet (for now, other refund terms), in their words. Anyone
// signed in adds their own; only the platform admin reads them (migration 20261026040000_refund_policy).
model OrganizerRequest {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  kind      String // 'refund_terms'
  userId    String
  tripId    String?
  tripName  String   @default("")
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Someone asking to start trips while Travel HQ is a limited preview, from the public page: name, email (lowercased,
// one request each) and an optional note. Anyone adds one; only the admin reads them (migration 20261031010000).
// Someone who runs a trip can refer a person, which tags the request with them; the admin approves a request, and
// whoever signs in with that email may then start trips (migration 20261031050000, issue #39).
model EarlyAccessRequest {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  email            String    @unique
  note             String    @default("")
  createdAt        DateTime  @default(now())
  referredByUserId String?
  approvedAt       DateTime?

  @@index([createdAt])
}

/// The admin's version of one email Travel HQ sends (src/messaging/email-defaults.ts has each one's default).
model EmailTemplate {
  kind            String   @id
  subject         String
  body            String
  updatedAt       DateTime @default(now())
  updatedByUserId String?
}

/// A bounce, blocked send or spam complaint Resend told us about (migration 20261029040000_email_problems).
model EmailProblem {
  id       String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  address  String
  kind     String
  subject  String   @default("")
  detail   String   @default("")
  at       DateTime @default(now())
  /// The guests it marked (migration 20261029050000_email_problem_guests), so a fixed one still shows.
  guestIds String[] @default([])

  @@index([at])
}

/// Every email Travel HQ sends, envelope only, kept 30 days (migration 20261031070000_organizer_alerts): the Admin
/// toolbox's Sent Emails, and when an organizer was last alerted. Status starts as what sending said and follows
/// Resend's webhook (delivered, delayed, bounced, blocked, complained).
model EmailSend {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  kind      String
  toAddress String
  subject   String   @default("")
  tripId    String?
  resendId  String?
  status    String
  detail    String   @default("")
  sentAt    DateTime @default(now())
  statusAt  DateTime @default(now())
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([sentAt])
  @@index([tripId])
  @@index([resendId])
  @@index([toAddress, kind])
}

/// One of Trip Control's Actions an organizer was already emailed about (migration 20261031070000_organizer_alerts),
/// so the next alert names only what's new. Removed once the action is done.
model ActionAlert {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  tripId    String
  key       String
  alertedAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId, key])
  @@index([tripId])
}

/// A sender an organizer vouched for when matching a forwarded receipt (migration 20261029080000_receipt_forwarding):
/// its next forwards are filed on that guest.
model PayerAddress {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId          String
  guestId         String
  address         String
  createdAt       DateTime @default(now())
  createdByUserId String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest           Guest    @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([tripId, address])
  @@index([guestId])
}

/// Every address a trip has used for forwarded receipts (migration 20261029080000_receipt_forwarding). One not released
/// is never chosen again; the platform admin releases a retired one. Not trip data: `tripId` is a plain id.
/// Its two partial unique indexes (one row not released per address, one current row per trip) and
/// ForwardedReceipt's on `paymentId` are in the migration only: Prisma can't say "unique where", so keep them when
/// writing a migration with `prisma migrate diff`.
model ReceiptsAddress {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  address          String
  tripId           String
  firstUsedAt      DateTime  @default(now())
  removedAt        DateTime?
  releasedAt       DateTime?
  releasedByUserId String?
}

/// One email received at a trip's receipts address, and what became of it (migration 20261029080000_receipt_forwarding).
model ForwardedReceipt {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  emailId          String    @unique
  toAddress        String?
  fromAddress      String?
  subject          String?
  receivedAt       DateTime  @default(now())
  tripId           String?
  // 'received' | 'processing' | 'recorded' | 'unmatched' | 'dismissed' | 'rejected' | 'failed'
  status           String    @default("received")
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  reason           String?
  error            String?
  senderVerified   Boolean   @default(false)
  amountCents      Int?
  payerName        String    @default("")
  methodKind       String?
  sentOn           String?
  excerpt          String    @default("")
  suggestedGuestId String?
  guestId          String?
  paymentId        String?
  decidedAt        DateTime?
  decidedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  trip             Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([status, nextAttemptAt])
  @@index([receivedAt])
}

// A question about a trip and its answer, the trip page's FAQ (issue #13, migration 20261030010000_trip_questions).
// A guest asks; an organizer answers for everyone or for the asker only, or adds an entry themselves (no asker).
model TripQuestion {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId         String
  askerUserId    String?
  askerName      String?
  askerEmail     String?
  question       String
  answer         String?
  status         String    @default("waiting") // QuestionStatus
  position       Int       @default(0)
  answeredByName String?
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([askerUserId])
}

// Failures people hit through no fault of their own, counted by /api/health/server-errors and watched by Better Stack
// (ops/monitoring.ts). A row is when, which kind and the route pattern: never a trip, person, email or error message,
// so not a tenant table. See migration 20261031020000.
model ServiceFailure {
  id    String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  at    DateTime @default(now())
  kind  String // 'server'
  route String // method and route pattern, such as 'POST /api/join/:slug'

  @@index([kind, at])
}

// "I'm interested" on a save the date (issue #47, migration 20261031080000_trip_interest): a signed-in person, once a
// trip. Apart from Guest on purpose, so interest is never a signature, a balance or a spot. Organizers only see it.
model TripInterest {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId    String
  userId    String
  firstName String
  lastName  String    @default("")
  email     String
  phone     String
  createdAt DateTime  @default(now())
  // When an organizer emailed them that sign-ups are open.
  toldAt    DateTime?
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}
