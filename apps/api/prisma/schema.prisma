generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The API's connection: the restricted role that row-level security binds (docs/tenant-isolation.md).
  url       = env("DATABASE_URL")
  // The database owner, for Prisma's CLI (migrations): the restricted role can't change the schema.
  directUrl = env("SCHEMA_DATABASE_URL")
}

// One group trip. The organizer edits it; guests see the published version at /t/<slug>.
// Photos, highlights and key dates are ordered lists the organizer replaces whole on save,
// so they live as JSON on the trip rather than as tables of their own.
model Trip {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  destination         String
  startDate           String // 'YYYY-MM-DD', a calendar date with no time zone
  endDate             String
  organizerName       String
  description         String
  costPerPersonCents  Int
  installmentCount    Int                  @default(1)
  galleryTitle        String               @default("Photos")
  showGuestNames      Boolean              @default(false)
  // Shown only to signed-in guests who joined the trip (their join page). Never on the public page.
  // How guests can pay the organizer (PaymentMethod[]: a fixed kind with its handle, or a free-form one), and a note
  // for anything else. A guest picks one of the methods when they report a payment.
  paymentMethods      Json                 @default("[]")
  paymentInstructions String               @default("")
  published           Boolean              @default(false)
  // A demo trip from the seed. The homepage shows only these, and their pages carry a "Sample Trip" badge.
  isSample            Boolean              @default(false)
  // The most guests the trip takes. Null means no limit.
  maxGuests           Int?
  // How guests who signed get in: 'accept_first' (the organizer accepts each one, then they pay), 'pay_first' (they
  // pay, then the organizer accepts each one whose payment arrived) or 'first_come' (they pay, and confirming a
  // payment accepts them while spots are left).
  joinMode            String               @default("accept_first")
  // How refunds work when a guest drops out (RefundPolicy): 'spot_filled' or 'first_payment_kept'. Presets only, and
  // fixed once a guest has signed (migration 20261026040000_refund_policy).
  refundPolicy        String               @default("spot_filled")
  photos              Json                 @default("[]") // TripPhoto[]; the first is the cover
  highlights          Json                 @default("[]") // TripHighlight[]
  keyDates            Json                 @default("[]") // TripKeyDate[]
  // TripOptions: settings that only change what the pages show (room choice, the sign-up lines). A setting the
  // database must enforce gets its own column instead.
  options             Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  guests              Guest[]
  members             TripMember[]
  invites             TripInvite[]
  rooms               Room[]
  log                 TripLog[]
  agreements          AgreementSignature[]
  payments            Payment[]
}

// Who works on a trip: an owner runs it and decides who else organizes it, an organizer works on it beside them.
// userId is the sign-in provider's user id. Row-level security draws the line between trips from these rows
// (migration 20261021050000_trip_rls).
model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String // 'owner' | 'organizer'
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

// Someone joining a trip. They sign in, sign the agreement and pay the organizer; then the organizer accepts them
// (or, on a first come, first served trip, confirming their payment does).
model Guest {
  id                 String              @id @default(cuid())
  tripId             String
  // The signed-in person who joined (the sign-in provider's user id). Null for guests added before sign-in.
  userId             String?
  firstName          String
  lastName           String
  email              String
  phone              String
  status             String              @default("interested") // 'interested' | 'approved' | 'declined'
  createdAt          DateTime            @default(now())
  // When the payments the organizer confirmed first added up to the first payment the guest's agreement asked for
  // (kept by the database from Payment, migration 20261025010000_payment_log). On a first come, first served trip
  // spots go in this order.
  spotPaidAt         DateTime?
  // When they joined onto the waitlist (the trip was full), and when an organizer offered them a spot that opened
  // (migration 20261026020000_waitlist). Waitlisted and not offered: no way to pay shown, and no payment taken.
  waitlistedAt       DateTime?
  offeredAt          DateTime?
  // When the organizer, turning a paid guest down, said the refund went out. Records it; moves no money.
  refundSentAt       DateTime?
  // The room the guest asked for (the organizer can change it), and who they'd like to share with.
  roomId             String?
  roomNote           String              @default("")
  room               Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  trip               Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  agreement          AgreementSignature?
  events             GuestEvent[]
  payments           Payment[]

  @@unique([tripId, userId])
  @@unique([id, tripId])
  @@index([tripId])
  @@index([userId])
}

// The trip agreement a guest signed, never changed once written (migration 20261023020000_join_and_agreements): the
// text exactly as shown and its SHA-256, the terms it quoted (the guest's balance comes from these, not the trip's
// current settings), the name they typed, and when and from where they signed.
model AgreementSignature {
  id               String   @id @default(cuid())
  tripId           String
  guestId          String   @unique
  templateVersion  String
  text             String
  textHash         String
  priceCents       Int
  installmentCount Int
  startDate        String
  endDate          String
  refundTerms      String
  typedName        String
  signedAt         DateTime @default(now())
  ipAddress        String
  userAgent        String
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest            Guest    @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@unique([guestId, tripId])
  @@index([tripId])
}

// One line of a guest's history, written only by the database's triggers (migration 20261024010000_guest_history):
// what happened, when, and who did it. Members of the trip read it; nobody writes, changes or deletes a line.
model GuestEvent {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId      String
  guestId     String
  at          DateTime @default(now())
  // 'joined' | 'signed' | 'said_paid' | 'payment_confirmed' | 'payment_not_received' | 'payment_undone' |
  // 'accepted' | 'turned_down' | 'put_back' | 'refund_sent' | 'refund_undone' | 'room_changed' | 'contact_changed'
  kind        String
  actorUserId String?
  actor       String // 'guest' | 'organizer' | 'system'
  fromRoomId  String?
  toRoomId    String?
  // For contact_changed: which details changed ('name', 'email', 'phone'), never their values.
  fields      String?
  // For the payment kinds: which payment, and its amount in whole cents (what the guest said they sent, or what the
  // organizer confirmed arrived).
  paymentId   String?
  amount      Int?
  n           Int      @default(autoincrement())
  guest       Guest    @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([guestId, at, n])
  @@index([tripId])
}

// One payment a guest sent the organizer, for any installment (migration 20261025010000_payment_log). The guest
// reports it (or the organizer logs one handed over in person); the organizer confirms it arrived or says it didn't.
// Amounts are whole cents. The guest's amount is never changed, so their word stays on record beside what arrived.
model Payment {
  id                    String    @id @default(cuid())
  tripId                String
  guestId               String
  // What the guest says they sent.
  guestPaymentAmount    Int
  // What the organizer says arrived, set when they confirm it (filled in with the guest's amount unless changed).
  receivedPaymentAmount Int?
  // How it was paid, as the guest picked it from the trip's methods ("Zelle · (555) 010-0199"), and its kind.
  method                String
  methodKind            String // PaymentMethodKind
  sentOn                String // 'YYYY-MM-DD', the day the guest says they sent it
  // Why, when it is less than what was due. Required then.
  note                  String    @default("")
  status                String    @default("reported") // 'reported' | 'confirmed' | 'not_received'
  loggedBy              String    @default("guest") // 'guest' | 'organizer'
  reportedAt            DateTime  @default(now())
  decidedAt             DateTime?
  decidedByUserId       String?
  // With 'refunded': the refund it went back with (the guest's refundSentAt then), so undoing that refund counts
  // only these payments again.
  refundedAt            DateTime?
  trip                  Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guest                 Guest     @relation(fields: [guestId, tripId], references: [id, tripId], onDelete: Cascade)

  @@index([tripId])
  @@index([guestId, reportedAt])
}

// A room or sleeping space on a trip, in the organizer's order. Edited in place so guests' room choices stick.
model Room {
  id        String   @id @default(cuid())
  tripId    String
  position  Int
  name      String
  beds      String   @default("")
  capacity  Int
  weight    Float    @default(1)
  // The beds in it, in order (BED_TYPES), for the room pictures guests choose from.
  bedTypes  String[] @default([])
  // The fewest people the room is priced for. Fewer than this and they pay for the empty places too.
  minPeople Int      @default(1)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  guests Guest[]

  @@index([tripId])
}

// Every change the platform admin makes to a trip's people (seating itself, handing a trip to an owner), written by
// the TripMember_9_admin_logged trigger, never by the API (migration 20261021070000_rooms_owners_access_log).
// What the trip's organizers should know beyond a guest's own history (migration 20261024020000_trip_log): for now,
// joins refused because the email is already on the trip, with what was typed and from where. Written only by
// log_refused_email; members read it.
model TripLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId      String
  at          DateTime @default(now())
  kind        String // 'email_refused'
  actorUserId String?
  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  blocked     Boolean  @default(false)
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
}

/// Someone invited to run a trip before they signed in; turned into a TripMember when they do (migration 20261028030000).
model TripInvite {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId    String
  email     String // lowercased
  role      String // 'owner' | 'organizer'
  invitedBy String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
  @@index([email])
}

model AccessLog {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId        String
  actorUserId   String
  action        String
  subjectUserId String
  role          String?
  oldRole       String?
  at            DateTime @default(now())
  byAdmin       Boolean  @default(true)

  @@index([tripId])
}

/// One person accepting one version of one of Travel HQ's own documents (src/terms/terms-text.ts): 'use', the Terms of
/// Use, or 'organizer', the Organizer Terms. Only ever added. No relation to a trip: acceptance is the person's.
model TermsAcceptance {
  id          String   @id @default(cuid())
  userId      String
  kind        String // 'use' | 'organizer'
  fingerprint String
  acceptedAt  DateTime @default(now())
  ipAddress   String
  userAgent   String

  @@unique([userId, kind, fingerprint])
}

// app-wide values the platform admin sets in the Admin toolbox ("System Settings"), one row (id 1). Everyone
// reads them; only the admin changes them (migration 20261026030000_system_settings).
model SystemSettings {
  id                    Int      @id @default(1)
  // On the pay-first trips, joining goes to the waitlist once those who can pay fill the spots left plus this percent.
  waitlistBufferPercent Int      @default(10)
  updatedAt             DateTime @default(now())
  updatedByUserId       String?
}

// What organizers ask Travel HQ for that it doesn't do yet (for now, other refund terms), in their words. Anyone
// signed in adds their own; only the platform admin reads them (migration 20261026040000_refund_policy).
model OrganizerRequest {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  kind      String // 'refund_terms'
  userId    String
  tripId    String?
  tripName  String   @default("")
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
