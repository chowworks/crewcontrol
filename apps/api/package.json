{
  "name": "@cc/api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "prisma migrate deploy && node dist/main",
    "lint": "eslint src prisma scripts",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "sync:types": "node scripts/sync-types.mjs",
    "role:create": "ts-node scripts/create-app-role.ts",
    "role:ensure": "ts-node scripts/ensure-app-role.ts",
    "deploy:start": "prisma migrate deploy && npm run role:ensure && node dist/main.js",
    "deploy:start:dev": "prisma migrate deploy && npm run role:ensure && npm run db:seed && node dist/main.js",
    "photos:move-to-r2": "ts-node scripts/move-photos-to-r2.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@clerk/backend": "^3.26.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.4.1",
    "fflate": "^0.8.3",
    "handlebars": "^4.7.10",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.35.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.7",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.5.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
